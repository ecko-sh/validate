# validators - the built-in validator constructors.
#
# Each returns a validator function `|value| -> null (pass) | message (fail)`.
# The invariant that keeps collect-all clean and crash-free: every validator
# checks exactly ONE concern and passes (null) on a null or wrong-typed value -
# so only its dedicated type/presence rule reports that error, and no validator
# ever runs `len`/`<` on the wrong type. Fields are optional by default;
# `required()` is the only rule that fails on null.
#
# NB: this module exports names like `string`/`int`/`list`/`map`/`min`/`max`
# that shadow builtins. It never CALLS those builtins internally (type checks go
# through `type_of`), so no `core.*` escape hatch is needed here.

import std.re
import "./check.ecko"

fn is_number(x) = type_of(x) == "int" or type_of(x) == "float"
fn is_string(x) = type_of(x) == "string"

# ---- presence --------------------------------------------------------------
## required() -> fails on null. The only rule that does: every other validator
## passes a null value, so fields are optional unless you say otherwise.
export fn required() = fn(value) if value == null { "is required" } else { null }
# A readability marker; fields are optional by default.
## optional() -> never fails. A marker for readers, since optional is already
## the default.
export fn optional() = fn(value) null

# ---- types (pass null; fail the wrong type) --------------------------------
## string() -> fails unless the value is text.
export fn string() = fn(value) if value == null or is_string(value) { null } else { "must be text" }
## int() -> fails unless the value is a whole number.
export fn int() = fn(value) if value == null or type_of(value) == "int" {
    null
} else {
    "must be a whole number"
}
## float() -> fails unless the value is a decimal number.
export fn float() = fn(value) if value == null or type_of(value) == "float" {
    null
} else {
    "must be a decimal number"
}
## number() -> fails unless the value is an int or a float.
export fn number() = fn(value) if value == null or is_number(value) {
    null
} else {
    "must be a number"
}
## bool() -> fails unless the value is true or false.
export fn bool() = fn(value) if value == null or type_of(value) == "bool" {
    null
} else {
    "must be true or false"
}
## list() -> fails unless the value is a list.
export fn list() = fn(value) if value == null or type_of(value) == "list" {
    null
} else {
    "must be a list"
}
## map() -> fails unless the value is a map.
export fn map() = fn(value) if value == null or type_of(value) == "map" {
    null
} else {
    "must be a map"
}

# ---- numbers (pass null and non-numbers) -----------------------------------
## min(n) -> fails when a number is below `n`. Non-numbers pass, so the type
## error is reported once by `number()` rather than by every rule.
export fn min(n) = fn(value) if value == null or not is_number(value) {
    null
} else if value < n {
    "must be at least {n}"
} else {
    null
}
## max(n) -> fails when a number is above `n`.
export fn max(n) = fn(value) if value == null or not is_number(value) {
    null
} else if value > n {
    "must be at most {n}"
} else {
    null
}
## between(lo, hi) -> fails when a number is outside `lo`..`hi`, inclusive.
export fn between(lo, hi) = fn(value) if value == null or not is_number(value) {
    null
} else if value < lo or value > hi {
    "must be between {lo} and {hi}"
} else {
    null
}
## positive() -> fails unless a number is greater than zero.
export fn positive() = fn(value) if value == null or not is_number(value) {
    null
} else if value > 0 {
    null
} else {
    "must be positive"
}
## negative() -> fails unless a number is less than zero.
export fn negative() = fn(value) if value == null or not is_number(value) {
    null
} else if value < 0 {
    null
} else {
    "must be negative"
}

# ---- strings (pass null and non-strings) -----------------------------------
## min_len(n) -> fails when text is shorter than `n` characters.
export fn min_len(n) = fn(value) if value == null or not is_string(value) {
    null
} else if len(value) < n {
    "must be at least {n} characters"
} else {
    null
}
## max_len(n) -> fails when text is longer than `n` characters.
export fn max_len(n) = fn(value) if value == null or not is_string(value) {
    null
} else if len(value) > n {
    "must be at most {n} characters"
} else {
    null
}
## len_between(lo, hi) -> fails when text length is outside `lo`..`hi`.
export fn len_between(lo, hi) = fn(value) if value == null or not is_string(value) {
    null
} else if len(value) < lo or len(value) > hi {
    "must be between {lo} and {hi} characters"
} else {
    null
}
## pattern(regex, msg?) -> fails when text does not match `regex`.
##
## `msg` replaces the default "has an invalid format", which is worth setting -
## a regex in an error message helps nobody.
export fn pattern(re_pat, msg = null) = fn(value) if value == null or not is_string(value) {
    null
} else if re.test(re_pat, value) {
    null
} else if msg == null {
    "has an invalid format"
} else {
    msg
}
## email() -> fails unless the text looks like an email address.
##
## A deliberately loose shape check (something@something.something). Whether an
## address exists is a question only sending to it can answer.
export fn email() = pattern("^[^@ ]+@[^@ ]+\\.[^@ ]+$", "must be a valid email")
## url() -> fails unless the text is an http or https URL.
export fn url() = pattern("^https?://[^ ]+$", "must be a valid URL")

# ---- membership (any type; passes null) ------------------------------------
## one_of(options) -> fails unless the value is one of `options`.
##
## Works for any type, and lists the allowed values in the message.
export fn one_of(options) = fn(value) if value == null {
    null
} else if contains(options, value) {
    null
} else {
    "must be one of: {join(options, \", \")}"
}

# ---- collections -----------------------------------------------------------
## non_empty() -> fails on empty text or an empty list.
export fn non_empty() = fn(value) if value == null {
    null
} else if not (is_string(value) or type_of(value) == "list") {
    null
} else if len(value) == 0 {
    "must not be empty"
} else {
    null
}

## each(validator) -> applies `validator` to every element of a list.
##
## Element failures are numbered from 1 and joined into one message, so the
## reader knows which item was wrong.
##
## example:
##   { tags: [v.list(), v.each(v.min_len(2))] }
export fn each(validator) = fn(value) {
    if value == null { null } else if type_of(value) != "list" { "must be a list" } else {
        mut msgs = []
        mut i = 0
        for item in value {
            m = validator(item)
            if m != null { msgs = push(msgs, "item {i + 1}: {m}") }
            i = i + 1
        }
        if len(msgs) == 0 { null } else { join(msgs, "; ") }
    }
}

## shape(schema) -> validates a nested map against its own schema.
##
## Sub-errors are flattened into a single `field: message` summary rather than a
## nested map. A deeper error tree is a future change.
export fn shape(schema) = fn(value) {
    if value == null { null } else if type_of(value) != "map" { "must be a map" } else {
        errs = check.check(value, schema)
        if len(keys(errs)) == 0 { null } else { summarize(errs) }
    }
}

fn summarize(errs) {
    mut parts = []
    for field in keys(errs) {
        for m in errs[field] {
            parts = push(parts, "{field}: {m}")
        }
    }
    join(parts, "; ")
}
